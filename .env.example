# 실서버 API base URL.
# 로컬 BE 연동: 비워두고 Vite proxy(/api → localhost:8080) 사용. MSW는 끈다 (VITE_ENABLE_MSW=false).
# 원격 BE 직결: https://api.example.com 형태로 설정 (BE CORS 필요).
#
# Vercel 권장:
#   Preview  — VITE_API_BASE_URL 비움 + VITE_ENABLE_MSW=true  (MSW, CORS 우회)
#   Production — VITE_API_BASE_URL=https://api.… + VITE_ENABLE_MSW=false
VITE_API_BASE_URL=

# true면 MSW worker가 /api/v1 요청을 가로챕니다. 실 BE 연동 시 false.
# Vite DEV뿐 아니라 Vercel Preview 빌드에서도 이 플래그로 켭니다.
VITE_ENABLE_MSW=true
